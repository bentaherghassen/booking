# Secret Key for Django
SECRET_KEY="django-insecure-your-secret-key-here"

# Telegram Bot Workflow Integration Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Gmail SMTP Email Workflow Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER="your_gmail_address@gmail.com"
EMAIL_HOST_PASSWORD="your_gmail_app_password" # 16-character Gmail App Password
DEFAULT_FROM_EMAIL="your_gmail_address@gmail.com"
ADMIN_EMAIL="admin@bentaherghassen.com"
